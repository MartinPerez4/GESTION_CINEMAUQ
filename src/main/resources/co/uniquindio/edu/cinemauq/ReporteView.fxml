<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.uniquindio.edu.cinemauq.controller.ReporteController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="📊 Panel de Reportes e Indicadores" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

    <HBox spacing="15.0">
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 6; -fx-pref-width: 250;" spacing="5">
            <Label text="Total Entradas Vendidas" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" />
            <Label fx:id="lblTotalEntradas" text="0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" />
        </VBox>
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 6; -fx-pref-width: 250;" spacing="5">
            <Label text="Total Ingresos Recaudados" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" />
            <Label fx:id="lblTotalIngresos" text="$0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2980b9;" />
        </VBox>
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 6; -fx-pref-width: 300;" spacing="5">
            <Label text="Película Más Taquillera" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" />
            <Label fx:id="lblTopPelicula" text="Ninguna" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #8e44ad;" />
        </VBox>
    </HBox>

    <VBox spacing="10.0" VBox.vgrow="ALWAYS">
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Detalle de Ocupación por Función" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button text="Actualizar Reportes" onAction="#handleActualizarReportes" style="-fx-background-color: #34495e; -fx-text-fill: white;" />
        </HBox>
        <TableView fx:id="tableReportes" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="Función / Película" prefWidth="220.0" />
                <TableColumn text="Sala" prefWidth="100.0" />
                <TableColumn text="Asientos Disponibles" prefWidth="140.0" />
                <TableColumn text="Asientos Ocupados" prefWidth="140.0" />
                <TableColumn text="Recaudo Parcial" prefWidth="130.0" />
            </columns>
        </TableView>
    </VBox>
</VBox>
